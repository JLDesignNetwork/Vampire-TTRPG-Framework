# Auto-detect text files and enforce LF (Unix-style) line endings on checkout and commit.
* text=auto eol=lf

# Explicitly declare text file extensions
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.txt text eol=lf

# Explicitly declare binary files (so Git doesn't attempt line-ending normalization or text diffs)
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary

# Future-proofing: Hide generated layout files from GitHub Language Statistics once books/ is tracked
books/**/*.html linguist-generated=true
books/**/*.css linguist-vendored=true
